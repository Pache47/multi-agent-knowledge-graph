# Copy to .env locally. Never commit the actual key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional independent claim + overall reviewer. Unset/empty uses OPENAI_MODEL.
# Try gpt-4.1, then compare saved wording and latency; it can still miss mistakes.
OPENAI_VERIFIER_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional local graph projection. The review workflow also runs without Neo4j.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
